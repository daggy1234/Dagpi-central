generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model application {
  uu             String   @id @db.Uuid
  appname        String   @db.VarChar(255)
  appdescription String   @db.VarChar(255)
  appurl         String   @db.VarChar(255)
  appuserid      BigInt   @unique(map: "application.appuserid_unique")
  approved       Boolean
  premium        Boolean
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @updatedAt @db.Timestamptz(6)
}

model tokens {
  userid     BigInt   @id
  apikey     String   @unique(map: "tokens.apikey_unique") @db.VarChar(64)
  totaluses  Int
  enhanced   Boolean
  ratelimit  Int
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)
}

model user {
  id            Int      @id @default(autoincrement())
  userid        BigInt   @unique(map: "user.userid_unique")
  client_id     String   @unique(map: "user.client_id_unique") @db.VarChar(32)
  client_secret String   @unique(map: "user.client_secret_unique") @db.VarChar(256)
  email         String
  name          String
  created_at    DateTime @default(now()) @db.Timestamptz(6)
}

model cli {
  id         Int      @id @default(autoincrement())
  client_id  String   @db.VarChar(32)
  name       String
  token      String   @unique(map: "cli.token_unique") @db.VarChar(50)
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model stripe_donation {
  id          Int      @id @default(autoincrement())
  client_id   String   @db.VarChar(32)
  receipt     String
  charge_id   String
  amount      Int
  customer_id String
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  currency    String
}

model paypal_donation {
  id          Int      @id @default(autoincrement())
  client_id   String   @db.VarChar(32)
  charge_id   String
  amount      Int
  customer_id String
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  currency    String
}

model stripe_customer {
  id          Int    @id @default(autoincrement())
  client_id   String @unique(map: "stripe_customer.client_id_unique") @db.VarChar(32)
  customer_id String @unique(map: "stripe_customer.customer_id_unique")
}

model stripe_subscription {
  customer_id        String   @unique(map: "stripe_subscription.customer_id_unique")
  subscription_id    String   @unique(map: "stripe_subscription.subscription_id_unique")
  price_id           String
  subscription_start DateTime @db.Timestamptz(6)
  subscription_end   DateTime @db.Timestamptz(6)
  cancelled          Boolean
  active             Boolean
  ratelimit          Int
  billing_end        DateTime @db.Timestamptz(6)
  currency           String
}
